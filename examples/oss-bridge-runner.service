# systemd 服务示例：放到 /etc/systemd/system/oss-bridge-runner.service
# 然后 systemctl daemon-reload && systemctl enable --now oss-bridge-runner
#
# 注意：请用专门的低权用户运行；runner 会执行 agent 下发的 shell 命令。

[Unit]
Description=oss-bridge runner (executes jobs delivered through OSS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME

# 方式一：已 pip 安装
ExecStart=/usr/local/bin/oss-bridge-runner \
    --endpoint oss-cn-hangzhou-internal.aliyuncs.com \
    --bucket your-bucket \
    --prefix oss-bridge \
    --ossutil-config /home/CHANGE_ME/.oss-bridge/ossutilconfig \
    --insecure-no-signature \
    --state-dir /home/CHANGE_ME/.oss-bridge/state \
    --concurrency 2

# 方式二：用远程脚本自动拉取最新代码（见 README 的 self-updating 一节）
# ExecStart=/bin/bash /home/CHANGE_ME/remote_run.sh

Restart=always
RestartSec=5
StandardOutput=append:/var/log/oss-bridge-runner.log
StandardError=append:/var/log/oss-bridge-runner.log

# 基本加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
