# 远程机器的默认配置，放到 ~/.oss-bridge/bridge.env
# 显式传入的环境变量优先级高于本文件。

OSS_BUCKET=your-bucket
OSS_PREFIX=oss-bridge
# 内网建议用 -internal 域名；公网域名在部分容器里因通配 DNS 解析不了
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com

# 1 = 不校验指令签名（私有目录够用，不需要额外密钥）
OSS_BRIDGE_NO_SIGNATURE=1

# 或者开启签名校验：把两端一致的密钥写进文件
# OSS_BRIDGE_SECRET_FILE=/home/USER/.oss-bridge/secret

# 可选
# OSS_BRIDGE_INSTANCE=runner-a
# OSS_BRIDGE_CONCURRENCY=4
# OSS_BRIDGE_LOG_LEVEL=INFO
