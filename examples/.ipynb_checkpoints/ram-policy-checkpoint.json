{
  "Version": "1",
  "Statement": [
    {
      "Comment": "本机（agent）需要：写指令、读结果、传文件、读注册表、发布代码",
      "Effect": "Allow",
      "Action": [
        "oss:PutObject",
        "oss:GetObject",
        "oss:ListObjects",
        "oss:ListObjectsV2",
        "oss:HeadObject"
      ],
      "Resource": [
        "acs:oss:*:*:your-bucket/oss-bridge/hosts/*",
        "acs:oss:*:*:your-bucket/oss-bridge/files/*",
        "acs:oss:*:*:your-bucket/oss-bridge/registry/*",
        "acs:oss:*:*:your-bucket/oss-bridge/src/*"
      ]
    },
    {
      "Comment": "远端 runner 需要：读指令、写结果、删已处理指令、传文件、写心跳",
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:DeleteObject",
        "oss:ListObjects",
        "oss:ListObjectsV2",
        "oss:HeadObject"
      ],
      "Resource": [
        "acs:oss:*:*:your-bucket/oss-bridge/hosts/*",
        "acs:oss:*:*:your-bucket/oss-bridge/files/*",
        "acs:oss:*:*:your-bucket/oss-bridge/registry/*",
        "acs:oss:*:*:your-bucket/oss-bridge/src/*"
      ]
    }
  ]
}
